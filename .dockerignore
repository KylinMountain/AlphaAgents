# Secrets — supplied at runtime via env_file, never baked into the image.
.env
.env.*
!.env.example

# Runtime data (SQLite DBs, Chroma index, caches) — bind-mounted instead.
data/
*.db
*.db-wal
*.db-shm
*.db.bak

.git/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# web/ IS needed: stage 1 builds the dashboard from it.
web/node_modules/
web/dist/

# Not needed at runtime.
tests/
docs/
research/
scripts/
deploy/
autoresearch/
*.log
*.csv
*.tsv
