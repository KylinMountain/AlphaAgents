# ============================================================
# AlphaAgents 环境变量配置
# 复制为 .env 并填入你的 API Key
# ============================================================

# ── LLM 角色表 ────────────────────────────────────────────────────
# 一个用途一套凭证，命名只有一种形状：
#
#     <ROLE>_API_KEY / <ROLE>_BASE_URL / <ROLE>_MODEL
#
#   AGENT      决策与分析 Agent（要聪明）        —— 交易决策走这里
#   DIGEST     新闻过滤与事件链接（可以便宜）    —— 每次一调，调错只损失一次重跑
#   SUMMARY    周报 / 复盘 / 上下文压缩（可以便宜）—— 输入是管线已产出的散文，只做缩短
#   EMBEDDING  概念与新闻向量（另一种 API 形状）
#   VPA        量价分析（见文件末尾 VPA_LLM_* 一节）
#
# 没配的角色继承它的父角色：SUMMARY ← DIGEST、VPA ← AGENT。
# 所以只写 AGENT_* 每处都能跑；只想让摘要变便宜，就单独写 SUMMARY_*。
# 查当前实际生效的模型：python main.py llm-roles
#
# 2026-09-17 之前这里有五套并行的命名（AGENT_/DIGEST_/EMBEDDING_/MIMO_/VPA_LLM_），
# 其中 MIMO_* 代码从来没读过。现已合并为上面一套。

# --- 共用（可选）：一个 key 兜底 embedding 与 digest ---
SILICONFLOW_API_KEY=sk-xxx           # 硅基流动免费 key: https://siliconflow.cn

# --- AGENT：决策与分析 Agent（smart 档） ---
# 默认 fallback 到 ANTHROPIC_API_KEY / DashScope，**强烈建议显式配**。
# 示例：OpenRouter（:free 模型零成本跑）
# AGENT_API_KEY=sk-or-xxx
# AGENT_BASE_URL=https://openrouter.ai/api/v1
# AGENT_MODEL=anthropic/claude-sonnet-4
#
# 零成本跑法: OpenRouter 的 :free 模型。model_factory 会自动挂上
# fallback 链，主模型过载/限流时换下一个。注意免费档是**账号级
# 50 次请求/天**（UTC 00:00 重置），换任何 :free 模型都是同一个池子；
# 一次晨扫是工具循环 + reflection，跑不满一整天的调度。
# AGENT_MODEL=inclusionai/ling-3.0-flash-fin:free
#
# 示例：本地 Ollama
# AGENT_API_KEY=ollama
# AGENT_BASE_URL=http://localhost:11434/v1
# AGENT_MODEL=qwen2.5
ANTHROPIC_API_KEY=sk-ant-xxx         # Anthropic 官方（AGENT_* 未配时的兜底）

# --- DIGEST：新闻筛选聚合（cheap 档） ---
# 只配 AGENT_* 而不配这里，digest 会落到 SiliconFlow 免费档。
# 建议与 AGENT_* 指向同一个可用 provider。
# DIGEST_API_KEY=sk-xxx
# DIGEST_BASE_URL=https://api.deepseek.com/v1
# DIGEST_MODEL=deepseek-chat

# --- SUMMARY：总结类任务（cheap 档，不写则继承 DIGEST） ---
# 周报、复盘、上下文压缩走这里。想让它们用更便宜的模型，只改这三行：
# SUMMARY_API_KEY=sk-xxx
# SUMMARY_BASE_URL=https://api.siliconflow.cn/v1
# SUMMARY_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- EMBEDDING：概念与新闻向量 ---
# 默认 SiliconFlow BGE-M3，也可换其他 OpenAI 兼容提供商
# EMBEDDING_API_KEY=sk-xxx           # 默认 fallback 到 SILICONFLOW_API_KEY
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3

# --- 推送通知（可配多个，都配就都推） ---
# NOTIFY_DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# NOTIFY_WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# NOTIFY_TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# NOTIFY_TELEGRAM_CHAT_ID=123456789

# --- Cloudflare Worker 代理（IP 轮换反爬） ---
# 部署 Worker: cd cloudflare && npx wrangler deploy
# 设置密钥: npx wrangler secret put AUTH_TOKEN
# CF_WORKER_URL=https://alpha-fetch-proxy.your-subdomain.workers.dev
# CF_WORKER_AUTH_TOKEN=your-secret-token

# --- 交易时段与分析开关 ---
# 监控循环只在交易时段调用 agent；其余时间只摄取新闻不分析——快讯照存，
# 晨扫会消化累积的窗口。这条是 token 开销的大头：非交易时段每轮两个
# agent，一天能多跑十几轮，产出的还是用收盘快照分析次日开盘。
#
# 期货夜盘（21:00–02:30）默认关闭，多数用户看的是 A 股。
# FUTURES_NIGHT_SESSION=1

# --- 本地新闻语义索引 ---
# 每次摄取后对新快讯做增量 embedding（不调 LLM），agent 的 search_news
# 工具从这里检索——追因要回答"某板块为什么异动"，答案通常就在这几小时
# 的快讯里，比搜索引擎更及时。
# 窗口而非归档：30 天约 7.5 万条向量、300MB、暴力检索 40ms；一年是 90 万
# 条 3.6GB，花在任何追因都不会问到的旧闻上。
# NEWS_INDEX_RETENTION_DAYS=30

# --- 监控设置 ---
# MONITOR_INTERVAL_SECONDS=300       # 新闻轮询间隔（秒）
# NEWS_FETCH_LIMIT=50                # 每个源每次最多拉取条数

# --- Tushare（龙虎榜 / 北向 / 两融 等 7 张 A 股表）---
# 两个变量名都认：TUSHARE_TOKEN 优先，TUSHARE_API_KEY 次之。历史上
# tushare_client 只读 TUSHARE_TOKEN 而 .env 写的是 TUSHARE_API_KEY，于是
# 操作者自己的 token 被静默忽略、回落到内置的公共 token，而公共 token 在
# 官方端点上被拒绝（"您的token不对"）——7 张表因此长期为 0 行。
# TUSHARE_TOKEN=...
#
# 端点默认官方 https://api.tushare.pro。旧默认是一个社区代理
# (121.40.135.59:8010)，2026-09-17 实测每次调用都 5 秒空返回，
# 导致 daily_archive 全部失败。只有需要走代理时才设这一条。
# TUSHARE_HTTP_URL=
#
# 权限说明：top_list / top_inst / moneyflow_hsgt / margin 在普通积分下可用；
# hm_detail / kpl_list / kpl_concept_cons / moneyflow_dc 需要更高权限，
# 缺权限时 daily_archive 记 warning 并跳过，不算失败。
